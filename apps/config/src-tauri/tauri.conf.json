{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boss Key 配置",
  "version": "3.0.0",
  "identifier": "cn.hanloth.bosskey.config",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Boss Key 设置",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ivanhanloth.github.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
